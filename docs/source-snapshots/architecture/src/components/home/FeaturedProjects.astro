---
import OptimizedImage from "../ui/OptimizedImage.astro";
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
  totalCount: number;
}
const { projects, totalCount } = Astro.props;
---

<section class="py-20 md:py-28 bg-[#f8f8f6]" aria-labelledby="selected-work-title">
  <div class="max-w-[1200px] mx-auto px-6 md:px-12">

    <!-- Section header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 md:mb-14">
      <div>
        <p class="text-[11px] tracking-[0.18em] uppercase text-accent mb-4" lang="en">Selected Work</p>
        <h2 id="selected-work-title" class="font-serif text-3xl md:text-4xl text-[#1a1a1a]">精选作品</h2>
        <p class="text-sm text-[#61685f] leading-relaxed mt-4">{projects.length} 件精选 / 共 {totalCount} 个项目 · 完整时间线就在下方</p>
      </div>
      <a
        href="#all-projects"
        class="inline-flex self-start sm:self-auto shrink-0 items-center min-h-11 px-5 py-3 text-sm bg-accent text-white rounded-sm hover:bg-accent-light focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent transition-colors"
      >
        查看全部 {totalCount} 个项目 ↓
      </a>
    </div>

    <!-- 3-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
      {projects.map((project) => (
        <a href={`/work/${project.id}`} class="project-card reveal group block focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-accent">

          <!-- Image -->
          <div class="img-wrap relative overflow-hidden aspect-[4/3] mb-5 bg-[#eee]">
            <OptimizedImage sizes="(max-width: 767px) calc(100vw - 48px), 340px"
              src={project.data.coverImage}
              alt={project.data.title}
              class="card-img w-full h-full object-cover"
              loading="lazy"
            />
            <div class="card-hint">
              <span style="color:white;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;font-weight:300;">
                查看项目 &nbsp;→
              </span>
            </div>
          </div>

          <!-- Text -->
          <p class="text-[11px] text-[#aaa] tracking-wider uppercase mb-2">
            {project.data.year} · {project.data.location}
          </p>
          <h3 class="card-title-cn font-serif text-[1.35rem] text-[#1a1a1a] mb-1 leading-snug">
            {project.data.title.split(' · ')[0]}
          </h3>
          <p class="text-[0.8rem] text-[#737971] leading-relaxed mb-3" lang="en">{project.data.title.split(' · ')[1]}</p>
          <p class="text-sm text-[#777] leading-relaxed">{project.data.description}</p>
          {project.data.collaborators && <p class="text-xs text-[#687467] leading-relaxed mt-3">合作署名 · {project.data.collaborators}</p>}
          <span class="inline-block text-sm text-accent mt-4 border-b border-[#b8c5b9] pb-px">查看项目 →</span>

        </a>
      ))}
    </div>

  </div>
</section>
