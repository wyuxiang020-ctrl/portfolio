---
import '../../styles/knowledge-case.css';
import StudioCover from '../../components/fangkuai/StudioCover.astro';
import CubeShowcase from '../../components/fangkuai/CubeShowcase.astro';
import '../../styles/fangkuai-update.css';
import CaseImage from '../../components/fangkuai/CaseImage.astro';
import FeedbackAvatar from '../../components/fangkuai/FeedbackAvatar.astro';
const states = [['待命','保持紧凑，占桌面最小空间'],['查找中','模块舒展，表示正在检索'],['已就绪','出现书签提示，表示有结果可看'],['需处理','静止与状态提示，表示需要你确认']];
const projects = [
  ['tank-shanghai','上海油罐艺术中心','OPEN Architecture','© Qingshan Wu','https://www.archdaily.com/935196/tank-shanghai-open-architecture'],
  ['copenhill','CopenHill','BIG','© Laurian Ghinitoiu','https://www.archdaily.com/925970/copenhill-energy-plant-and-urban-recreation-center-big'],
  ['jingdezhen-kiln','景德镇御窑博物馆','Studio Zhu-Pei','图片提供：Studio Zhu-Pei','https://www.archdaily.com/948083/jingdezhen-imperial-kiln-museum-studio-zhu-pei'],
  ['lochal-library','LocHal 图书馆','CIVIC architects 等','© Stijn Bollaert','https://www.archdaily.com/909540/lochal-library-mecanoo-plus-civic-architects-plus-braaksma-and-roos-architectenbureau'],
];
const feedback = [
  ['高级设计师', '参考项目，要能看出设计做法。', '只有一张局部图和项目名称，很难判断它是否值得继续研究。', '补齐项目主图、设计线索和中文摘要，让案例比较有具体依据。'],
  ['设计师助理', '找过的条文，不想再从头找。', '规范与地方政策混在一起，打开原文后还要重新定位分类和关键词。', '按范围与主题分层；返回时保留查找条件，摘录与来源保持关联。'],
  ['总建筑设计师', '讨论方案时，依据要随手可查。', '摘要能帮助理解，但不能替代原文；一条意见需要回到具体的项目和条款。', '把来源、版本和核对日期放进档案，阅读时可以直接核对原文。'],
];
---
<article class="fk" data-gallery-group="fangkuai">
  <section class="fk-hero" aria-labelledby="fk-title">
    <div class="fk-topline"><a href="/work/">← 全部作品</a><span>FANGKUAI / PRODUCT CASE</span></div>
    <h1 id="fk-title">方块 · 建筑设计知识工作台</h1>
    <div class="fk-hero-copy"><p class="fk-headline">把项目资料，<br/>带回设计现场。</p><p>面向建筑设计中的资料查找与来源核对。将项目档案、公开案例、规范索引与重庆政策整理为可浏览、可阅读、可回查的知识工作台，并通过桌面方块提供按需入口。</p></div>
    <div class="fk-phase-tags"><span>本机原型已实现</span><span>独立交互演示已交付</span><span>持续验证中</span></div>
    <figure class="fk-image fk-cover"><StudioCover priority/><figcaption>建筑工作室场景与界面示意 · AI 场景底图，网页原生界面；屏幕案例图片提供：Studio Zhu-Pei</figcaption></figure>
    <p class="fk-tags">ToB · 2026.05 至今 · 产品定义 / 信息架构 / 交互设计 · 本次更新：2026.10.12</p>
  </section>
  <nav class="fk-nav" aria-label="方块案例章节"><a href="#origin">起点</a><a href="#product">产品全貌</a><a href="#companion">桌面小方</a><a href="#feedback">反馈与取舍</a><a href="#deliverables">交付物</a></nav>
  <section class="fk-section fk-split" id="origin" aria-labelledby="fk-origin">
    <h2 class="fk-label" id="fk-origin">01 / 起点</h2><div class="fk-prose">
      <p>在重庆市设计院实习时，我需要确认一个项目的防火间距要求，要同时翻三份文件——国标、地方规范、还有一个旧项目的图纸说明。每次都要重新找一遍。</p>
      <p>更麻烦的是，找到之后你不确定这条是否还适用：版本是不是最新的、有没有地方调整、之前项目是怎么处理的。三个问题，三个地方，一个下午可能就查了两三件事。</p>
      <p class="fk-emphasis">我把查找、阅读和来源核对放进同一个工作台，让找到的资料可以直接用于下一步设计讨论。</p>
    </div>
  </section>
  <section class="fk-section" id="product" aria-labelledby="fk-product">
    <h2 class="fk-label" id="fk-product">02 / 产品全貌</h2>
    <p class="fk-path">独立演示的研究路径：发现资料 → 来源阅读 → 摘录笔记 → 研究夹 → 回到来源。</p>
<div class="fk-module fk-new-entry" id="entry-design"><div class="fk-module-heading"><span>ENTRY DESIGN / 2026.10.12</span><h3>从三个入口开始</h3><p>先判断要找项目、查规范还是看地区政策，再进入资料。照片帮助辨认场景，分类负责缩小查找范围。</p></div>
<div class="fk-entry-grid">
<article><a href="#library"><img src="/images/fangkuai-2026-10-12/33-jingdezhen-original.jpg" alt="景德镇御窑博物馆，Studio Zhu-Pei 提供" width="2000" height="1500" loading="lazy"/><h4>01 / 项目档案 ↗</h4></a><p>从建筑整体形象进入项目，查看设计线索、文档目录和原始来源。</p><small><a href="https://www.archdaily.com/948083/jingdezhen-imperial-kiln-museum-studio-zhu-pei" target="_blank" rel="noreferrer">图片提供：Studio Zhu-Pei ↗</a></small></article>
<article><a href="#taxonomy"><img src="/images/fangkuai-2026-10-12/31-reference-desk-original.png" alt="参考书与图纸，AI 生成的规范查阅场景示意" width="1536" height="1024" loading="lazy"/><h4>02 / 规范标准 ↗</h4></a><p>按基础与空间、安全防护、环境与性能逐层查阅；先核对版本，再回到官方条文。</p><small>参考书与图纸 · AI 场景示意</small></article>
<article><a href="#taxonomy"><img src="/images/fangkuai-2026-10-12/32-chongqing-original.jpg" alt="重庆城市实景，Renek78 摄影，CC0 1.0" width="4000" height="1559" loading="lazy"/><h4>03 / 地区政策 ↗</h4></a><p>以重庆为例，整理空间规划、建设管理、特色与更新资料，保留文件性质与官方入口。</p><small><a href="https://commons.wikimedia.org/wiki/File:September_2025_in_Chongqing_08.jpg" target="_blank" rel="noreferrer">重庆城市实景 · Renek78 / CC0 ↗</a></small></article>
</div><details class="fk-detail"><summary>登录与工作台入口 <span>＋</span></summary><div class="fk-login-note"><span>界面已完成 / 账号登录暂未开通</span><p>新版产品首页已完成登录窗口和本机工作台入口。登录表单尚未启用账号服务；此作品页仅说明交付范围，不收集邮箱或密码。独立演示的公开访问权限尚未核实。</p><a href="#deliverables">查看交付说明 ↗</a></div></details></div>
<div class="fk-stage-overview"><h3>已交付的部分，各自走到哪一步</h3><div class="fk-stage-table" role="table" aria-label="交付层与当前边界"><div class="fk-stage-row fk-stage-head" role="row"><span role="columnheader">交付层</span><span role="columnheader">已完成</span><span role="columnheader">当前边界</span></div><div class="fk-stage-row" role="row"><strong role="rowheader">本机知识工作台</strong><p role="cell">真实 PDF / TXT / MD 资料、文本检索、指定项目与 2–4 项目比较、引用上下文、原始文档及跨分卷阅读。</p><p role="cell">单人本机入口，依赖云端存储和模型；生成服务仍需恢复并重新验收。</p></div><div class="fk-stage-row" role="row"><strong role="rowheader">Windows 桌面小方</strong><p role="cell">拖动、展开收起、置顶、托盘、减弱动效、按需启动工作台与查询状态展示。</p><p role="cell">未安装开机自启；不是完全离线程序，只同步状态与数量等白名单元数据。</p></div><div class="fk-stage-row" role="row"><strong role="rowheader">独立网页演示</strong><p role="cell">公开资料浏览、关键词查找、层级分类、来源阅读、收藏、摘录和研究夹。</p><p role="cell">20 个公开案例＋8 项规范索引＋8 项政策索引；保存在当前浏览器，未接入私人库与实时 RAG。</p></div><div class="fk-stage-row" role="row"><strong role="rowheader">新版产品首页</strong><p role="cell">三种资料场景、照片封面、来源说明、FAQ、登录窗口和动态方块形态展示。</p><p role="cell">账号登录暂未开通；场景与动画不是模型实际任务结果。</p></div><div class="fk-stage-row" role="row"><strong role="rowheader">截图旁批</strong><p role="cell">选区编号、建议展开、保存和回看交互。</p><p role="cell">内容为预编写示例，没有真实截图分析、自动读图或 CAD 操作。</p></div></div><p class="fk-note">两套资料口径分别计算：独立演示为 36 条目录（20 个公开案例、8 项规范索引、8 项重庆政策索引）；本机 RAG 收录 15 个公开案例，不与演示数量相加。规范与政策的来源核对日期为 2026.10.08，索引不替代官方全文。</p></div>
    <div class="fk-module" id="library">
      <div class="fk-module-heading"><span>01 / LIBRARY</span><h3>一座可以浏览的建筑资料馆</h3></div>
      <CaseImage name="library-detail" alt="方块建筑项目分类界面，呈现公开案例主图和资料信息" caption="建筑案例 · 主图与设计信息" />
      <div class="fk-offset-copy"><p>每个案例配有中文研究摘要，先帮助读者了解设计做法。摘要与原文分开呈现，需要核实时，可以直接打开原始来源。</p></div>
      <div class="fk-project-wall">{projects.map(([key,title,architect,credit,url])=><div><CaseImage name={key} alt={`${title}建筑主图，${architect}设计，${credit}`} caption={title}/><p>{architect}<br/>{credit}</p><a href={url} target="_blank" rel="noreferrer">项目来源 ↗</a></div>)}</div>
      <div class="fk-offset-copy"><p>规范和政策按范围、大类、细类分层索引。标准号、文号、来源与版本信息一起保留。当前收录是查阅索引，核对日期与适用边界随资料显示。</p></div>
      <div id="taxonomy"></div><CaseImage name="taxonomy" alt="重庆政策分类索引，按范围、特色与更新大类和细分主题组织" caption="规范与政策 · 范围 / 大类 / 细分主题" />
    </div>
    <div class="fk-module" id="reading">
      <div class="fk-module-heading"><span>02 / READ & VERIFY</span><h3>看见项目，也看见它的出处</h3></div>
      <div class="fk-reading"><CaseImage name="reading" alt="CopenHill 来源阅读页，包含项目主图、设计线索、档案信息与原始来源" caption="独立交互演示 · CopenHill 来源阅读页" /><div class="fk-prose"><p>把主图、设计事实、核对日期与原始来源放在同一份档案中。以 CopenHill 为例：项目年份、面积、设计说明、立面做法，每条线索都标明来源，并可一键跳转 ArchDaily 原页。</p><p>本机工作台另有真实文本检索与阅读链路：从引用查看邻近上下文，打开原始 PDF，并跨分卷保留阅读位置。已入库不代表模型理解了全部图纸；当前生成服务仍需恢复后重新验收。</p></div></div>
    </div>
    <figure class="fk-image fk-new-reader"><img src="/images/fangkuai-2026-10-12/21-demo-project-reader.png" alt="独立交互演示中的御窑博物馆阅读页，显示中文摘要、核对日期和来源链接" width="1264" height="1702" loading="lazy" decoding="async" data-gallery="fangkuai"/><figcaption>独立交互演示 · 公开案例阅读页；不是实时 RAG 回答</figcaption></figure>
    <div class="fk-module" id="research">
      <div class="fk-module-heading"><span>03 / RESEARCH</span><h3>把读到的内容，留下自己的判断</h3></div>
      <p class="fk-scope-label">独立网页演示 · 收藏、摘录与个人想法保存在当前浏览器，刷新后可回看；尚不支持账号同步或跨设备管理。</p>
      <CaseImage name="research-folder" alt="方块研究夹的公共空间专题，保留 CopenHill 阅读摘录、个人想法及来源入口" caption="研究夹 · 保存示例摘录与个人想法" />
      <div class="fk-copy-grid"><p>读到一条有用的线索，可以摘录下来，附上一句自己的想法，放进专题里。下一次打开，仍然能回到来源。</p><p>比如从 CopenHill 的案例里摘一条"屋顶公共路径"，写一句"能不能用在自己的项目里"，归到"公共空间"专题。研究夹保存的是你的判断过程，不是资料本身。</p></div>
      <details class="fk-detail"><summary>查看摘录表单 <span>＋</span></summary><CaseImage name="excerpt" alt="摘录表单，选择公共空间专题并填写自己的设计想法" caption="摘录表单 · 演示输入" /></details>
    </div>
    <div class="fk-module" id="annotation">
      <div class="fk-module-heading"><span>04 / ANNOTATION</span><h3>设计继续进行，讨论留在图纸旁边</h3></div>
      <p class="fk-scope-label">截图旁批交互原型：从选区编号进入一条建议，再保存并返回图中。当前图纸与建议为预编写示例，真实视觉分析尚未接入。</p>
      <CaseImage name="annotation" alt="截图旁批交互示例，社区阅览室平面选区对应入口转折建议" caption="截图旁批 · 交互设计示例" />
      <div class="fk-copy-grid"><p>截图旁批围绕入口关系、流线和空间尺度等局部问题设计。交互从用户主动截图开始：框选区域、补充问题，再在图纸旁查看意见，让讨论始终对应到具体位置。</p><div><p>每条旁批围绕一个选区、一次一条建议。操作提示和依据按需展开，默认收起。保存后可以回到原图位置。</p></div></div>
    </div>
  </section>
  <section class="fk-section fk-companion" id="companion" aria-labelledby="fk-companion">
    <h2 class="fk-label" id="fk-companion">03 / 桌面搭档小方</h2>
    <div class="fk-module-heading"><h3>需要时，叫小方。</h3><p>给桌面搭档取名「小方」，沿用资料模块的方形轮廓。它负责传递工作台的状态，需要时展开，不需要时安静地待在一角，让画图和思考保持连贯。</p></div>
    <div class="fk-cube-layout"><CubeShowcase/><div class="fk-prose"><h3>同一个小方，两种展示层。</h3><p>小方把工作台状态留在桌面一角。需要时展开，完成查阅后收起；只同步状态，不同步问题和原文。</p><p>首页的四种变形展示它的动作语言：待命、查找、整理、完成。这里可以手动切换，也可暂停自动轮换；它不读取私人任务状态，不表示模型正在分析图纸。</p><p class="fk-note">下方的待命、查找中、已就绪、需处理，是桌面运行状态说明；与首页品牌形态演示分别呈现。</p></div></div>
    <CaseImage name="ip-states" alt="小方四种状态并排：待命、查找中、已就绪、需处理" caption="基于产品实际几何与样式绘制的状态示意" flat />
    <div class="fk-states">{states.map(([title,description],i)=><div><CaseImage name={`state-${i+1}`} alt={`小方 ${title} 状态：${description}`} flat/><h4><span>0{i+1}</span> {title}</h4><p>{description}</p></div>)}</div>
    <aside class="fk-callout"><p>状态有边界：只同步状态，不同步问题原文。桌面上看到的是"有结果了"，不是"你在查什么"。</p><p>支持拖动、收起、置顶、托盘、减弱动效与按需启动本机工作台。未安装开机自启，仍依赖云端存储与模型，不是完全离线程序。</p></aside>
  </section>
  <section class="fk-section" id="feedback" aria-labelledby="fk-feedback">
    <h2 class="fk-label" id="fk-feedback">04 / 使用反馈与取舍</h2>
    <h3 class="fk-section-title">不同岗位，关心的是不同的问题。</h3>
    <p class="fk-feedback-intro">已邀请三位设计院同事参与试用，覆盖高级设计师、设计师助理与总建筑设计师。根据作者汇总的意见，本轮重点补齐真实资料、项目主图、分类索引和低干扰入口。逐人任务记录与量化使用结果仍待补充。</p>
    <p class="fk-note">虚拟头像与岗位情境示意 · 作者汇总转述，不是逐字访谈或个人推荐语</p>
    <div class="fk-feedback-grid">{feedback.map(([role,title,problem,response],i)=><article class="fk-feedback-card">
      <div class="fk-feedback-person"><FeedbackAvatar variant={i}/><div><span>0{i+1} / 使用场景</span><h4>{role}</h4></div></div>
      <h5>{title}</h5><p>{problem}</p>
      <div class="fk-feedback-response"><span>对应调整</span><p>{response}</p></div>
    </article>)}</div>
    <div class="fk-decisions">
      <div class="fk-decisions-heading"><span class="fk-label">PRODUCT DECISIONS</span><h3>先让资料可用，再考虑功能的多少。</h3></div>
      <div class="fk-decision"><span class="fk-decision-status">优先调整 / 内容</span><div><h4>先补齐一个项目，再扩大资料量。</h4><p>完整主图、设计事实和来源入口，是判断参考价值的基础。我把这些内容放在同一份档案里，并区分研究摘要与原文。相比继续增加案例，先让读者看懂、查得到依据，更能支持方案讨论。</p></div></div>
      <div class="fk-decision"><span class="fk-decision-status">优先调整 / 查找</span><div><h4>分类负责缩小范围，关键词负责定位。</h4><p>规范与政策各有自己的分类逻辑，不适合放进一张平铺列表。我保留范围、大类、细分主题，再加入分类内关键词查找；打开资料后返回，仍保留原来的分类和关键词。读到的线索可以进入研究夹，并保留回到来源的路径。</p></div></div>
      <div class="fk-decision"><span class="fk-decision-status fk-decision-later">范围取舍 / 少打断</span><div><h4>保留主动调用，不增加持续提醒。</h4><p>画图时，提示多不等于帮助多。小方只显示工作状态，旁批按选区逐条展开，摘录也由使用者决定是否保留。这一版不把自动弹窗、整页建议和复杂的协作管理作为重点，优先照顾个人查阅与设计思考的连续性。</p></div></div>
    </div>
  <div class="fk-next-stage"><span class="fk-label">NEXT / 下一阶段</span><h3>先让资料有依据，再扩大功能。</h3><p>本阶段完成了真实资料组织、来源阅读和多种入口，但展示完成度还不能替代任务验证。下一步先恢复并验证问答链路，做深少量案例，再检验它是否真正缩短建筑资料查找与核对的时间。</p><div class="fk-next-grid"><div><h4>参考价值不够清楚</h4><p>补整体封面、设计线索与来源；继续做深 5 个代表案例，检查少量难 PDF 页。</p></div><div><h4>找到答案后，仍需核对原文</h4><p>连接引用、邻近上下文和分卷阅读；建立人工参考证据题集，逐项检查结论。</p></div><div><h4>演示完成，不等于稳定可用</h4><p>区分服务故障、证据不足与交互示例；隔离历史测试数据，邀请独立参与者完成真实查找与比较任务。</p></div></div><details class="fk-detail"><summary>阶段验证说明 · 2026.10.11 <span>＋</span></summary><p>6 次检索抽查中，5 次返回成功、1 次请求失败。生成服务认证未通过，本轮没有完成问答质量评估。这些是执行记录，不能换算为答案准确率，也不能代替真实任务中的效率和满意度测量。</p></details></div>
  </section>
