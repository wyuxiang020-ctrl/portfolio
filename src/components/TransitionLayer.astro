---
const path = Astro.url.pathname;
const label = path === '/' ? '首页' : path === '/work/' ? '作品' : path === '/about/' ? '关于' : path === '/contact/' ? '联系' : path === '/resume/' ? '简历' : '项目';
const en = path === '/' ? 'Home' : path === '/work/' ? 'Work' : path === '/about/' ? 'About' : path === '/contact/' ? 'Contact' : path === '/resume/' ? 'Resume' : 'Project';
---
<div class="route-layer" aria-hidden="true"><div><span class="route-title"><i></i><span data-route-label>{label}</span></span><small data-route-en>{en}</small></div></div>
<style is:global>
  .route-layer{position:fixed;inset:0;z-index:400;background:#1c1d20;color:#fff;display:grid;place-items:center;transform:translateY(105%);visibility:hidden;pointer-events:none;border-radius:45% 45% 0 0;transition:transform .55s cubic-bezier(.76,0,.24,1),border-radius .55s,visibility .55s; font-family:Arial,"Microsoft YaHei",sans-serif}
  .route-title{display:flex;align-items:center;gap:22px;font-size:clamp(38px,5vw,70px);font-weight:400;line-height:1.4}.route-title i{width:8px;height:8px;border-radius:50%;background:currentColor}.route-layer small{display:block;text-align:center;color:#a6a6a8;font-size:14px;margin-top:14px;letter-spacing:.12em}.nav-leaving .route-layer,.nav-arriving .route-layer{visibility:visible;transform:translateY(0);border-radius:0;pointer-events:auto}.nav-arriving .route-layer{transition:none}.nav-arrived .route-layer{transform:translateY(-105%);border-radius:0 0 40% 40%}.nav-leaving{cursor:progress}.nav-reset .route-layer{transition:none;visibility:hidden}.route-layer>div{transition:opacity .2s}.nav-leaving .route-layer>div{animation:route-word .5s both}@keyframes route-word{0%,35%{opacity:0;transform:translateY(18px)}100%{opacity:1;transform:translateY(0)}}
  @media(prefers-reduced-motion:reduce){.route-layer{display:none!important}}
</style>
<script src="../scripts/route-transitions.ts"></script>
