---
import type { HTMLAttributes } from 'astro/types';
import manifest from '../../data/architecture-images.json';
interface Props extends HTMLAttributes<'img'> { src: string; alt: string; gallery?: boolean }
const { src, alt, sizes = '(max-width: 760px) calc(100vw - 46px), 1000px', loading = 'lazy', decoding = 'async', gallery = true, ...attributes } = Astro.props;
const entry = (manifest as Record<string, { width: number; height: number; variants: { src: string; width: number }[] }>)[src];
if (src.startsWith('/images/projects/') && !entry) throw new Error(`Missing architectural image: ${src}`);
const fallback = entry?.variants.find(v => v.width >= 960) ?? entry?.variants.at(-1);
---
<img {...attributes} src={fallback?.src ?? src} srcset={entry?.variants.map(v => `${v.src} ${v.width}w`).join(', ')} sizes={entry ? sizes : undefined} width={entry?.width ?? attributes.width} height={entry?.height ?? attributes.height} alt={alt} loading={loading} decoding={decoding} data-full-src={gallery ? src : undefined} data-full-width={gallery ? entry?.width : undefined} data-full-height={gallery ? entry?.height : undefined} />
