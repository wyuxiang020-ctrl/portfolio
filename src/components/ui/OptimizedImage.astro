---
import type { HTMLAttributes } from 'astro/types';
import manifest from '../../../.generated/images.json';

interface Props extends HTMLAttributes<'img'> {
  src: string;
  alt: string;
}
const { src, alt, sizes = '(max-width: 767px) calc(100vw - 48px), 720px',
  loading = 'lazy', decoding = 'async', ...attributes } = Astro.props;
const entry = (manifest as Record<string, {
  width: number; height: number; variants: { src: string; width: number }[];
}>)[src];
if (src.startsWith('/images/') && !entry) throw new Error(`Missing local image: ${src}`);
const fallback = entry?.variants.find(v => v.width >= 960) ?? entry?.variants.at(-1);
---
<img
  {...attributes}
  src={fallback?.src ?? src}
  srcset={entry?.variants.map(v => `${v.src} ${v.width}w`).join(', ')}
  sizes={entry ? sizes : undefined}
  width={entry?.width ?? attributes.width}
  height={entry?.height ?? attributes.height}
  alt={alt}
  loading={loading}
  decoding={decoding}
  data-full-src={src}
  data-full-width={entry?.width}
  data-full-height={entry?.height}
/>
