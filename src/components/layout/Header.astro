---
const navItems = [
  { label: '全部作品', href: '/work'    },
  { label: '关于',     href: '/about'   },
  { label: '联系',     href: '/contact' },
];

const path = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-[1200px] mx-auto px-6 md:px-12 py-6 flex items-center justify-between">

    <!-- Logo -->
    <a
      href="/"
      class="font-serif text-lg sm:text-xl tracking-[0.12em] text-[#1a1a1a] hover:text-accent transition-colors duration-200 select-none shrink-0"
      aria-label="王誉翔 Yuxiang Wang — 首页"
    >
      王誉翔<span lang="en" class="hidden md:inline ml-3 text-[11px] tracking-[0.08em]">Yuxiang Wang</span>
    </a>

    <!-- Nav -->
    <nav aria-label="主导航">
      <ul class="flex items-center gap-5 sm:gap-8 list-none m-0 p-0">
        {navItems.map(({ label, href }) => {
          const active = path === href || (href !== '/' && path.startsWith(href));
          return (
            <li>
              <a
                href={href}
                class={[
                  'nav-link text-[12px] tracking-[0.08em] font-sans transition-colors duration-200 whitespace-nowrap',
                  active ? 'text-accent nav-active' : 'text-[#1a1a1a] hover:text-accent',
                ].join(' ')}
                aria-current={active ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  /* Live-query the header on every tick so the reference stays valid after
     Astro View Transitions swap the <body> (which removes the old element). */
  function tick() {
    const header = document.getElementById('site-header');
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.add('bg-white/96', 'backdrop-blur-sm', 'border-b', 'border-[#e5e5e5]');
    } else {
      header.classList.remove('bg-white/96', 'backdrop-blur-sm', 'border-b', 'border-[#e5e5e5]');
    }
  }

  window.addEventListener('scroll', tick, { passive: true });

  /* Re-run after each SPA navigation so the new header gets its initial
     scroll-state immediately (scroll position is reset to 0 on nav). */
  document.addEventListener('astro:page-load', tick);

  tick(); /* initial load */
</script>
