---
interface Props { variant: number }
const { variant } = Astro.props;
const backgrounds = ['#e7ece5', '#e8eaf1', '#ece5dd'];
const shirts = ['#596e53', '#687991', '#87715f'];
---
<svg viewBox="0 0 80 80" fill="none" aria-hidden="true" class="fk-avatar">
  <circle cx="40" cy="40" r="40" fill={backgrounds[variant]} />
  <path d="M12 80V69c0-14 12-24 28-24s28 10 28 24v11" fill={shirts[variant]} />
  <path d="M34 44h12v12c-4 4-8 4-12 0z" fill="#d4a888" />
  <ellipse cx="40" cy="32" rx="15" ry="19" fill="#e5bea0" />
  {variant === 0 && <path d="M25 31c-4-18 5-23 15-23 15 0 21 13 15 27l-4-15c-7 5-16 2-20 0z" fill="#3c403b" />}
  {variant === 1 && <path d="M24 40c-8-24 3-32 17-31 15 1 18 16 14 33l-5-18c-8 0-14-4-18-7l-2 24z" fill="#675047" />}
  {variant === 2 && <path d="M24 32C20 15 31 9 40 9c14 0 21 13 15 25l-5-15c-9 6-16 3-19 2z" fill="#8a8982" />}
  <path d="M34 41q6 5 12 0" stroke="#a87660" stroke-width="1.5" stroke-linecap="round" />
  <path d="M33 32h1m12 0h1" stroke="#3a3632" stroke-width="2.5" stroke-linecap="round" />
  {variant !== 1 && <g stroke="#4e514b" stroke-width="1.3"><rect x="27" y="27" width="11" height="9" rx="3"/><rect x="42" y="27" width="11" height="9" rx="3"/><path d="M38 30h4"/></g>}
</svg>
