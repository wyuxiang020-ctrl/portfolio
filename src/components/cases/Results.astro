---
interface Props { headers: string[]; rows: string[][]; }
const { headers, rows } = Astro.props;
---
<div class="results-table" tabindex="0" role="region" aria-label={headers.join('、') + '，可横向滚动'}>
  <table><thead><tr>{headers.map(h => <th scope="col">{h}</th>)}</tr></thead>
    <tbody>{rows.map(row => <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
  </table>
</div>
