---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import sharp from 'sharp';
interface Props { name: string; alt: string; priority?: boolean; portrait?: boolean }
const { name, alt, priority = false, portrait = false } = Astro.props;
const src = `/images/gym/${name}.png`;
const file = resolve('public', `images/gym/${name}.png`);
const available = existsSync(file);
const dimensions = available ? await sharp(file).metadata() : null;
---
<figure class:list={['gc-image', { 'gc-image-portrait': portrait }]}>
  {available ? <img src={src} alt={alt} width={dimensions?.width} height={dimensions?.height} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" data-gallery="gym" /> :
    <div class="gc-image-placeholder" role="img" aria-label={`${alt}（图片待补充）`}>
      <svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><rect x="10" y="10" width="44" height="44" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="25" cy="24" r="4" stroke="currentColor" stroke-width="1.5"/><path d="m11 45 14-12 11 9 8-7 10 9" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>图片待补充</span><code>{name}.png</code>
    </div>}
</figure>
