---
import { resolve } from 'node:path';
import sharp from 'sharp';
interface Props { name: string; alt: string; priority?: boolean; portrait?: boolean }
const { name, alt, priority = false } = Astro.props;
const groups: Record<string, { file: string; alt: string }[]> = {
  'gym-hero': [
    { file: 'home', alt: 'Gym 首页：今日训练与熊猫陪伴' },
    { file: 'training', alt: 'Gym 训练界面：逐组记录重量与次数' },
    { file: 'panda-rest', alt: 'Gym 组间休息：熊猫陪伴与休息计时' },
  ],
  'gym-scanner': [
    { file: 'scan', alt: '扫描器械并查看识别候选' },
    { file: 'equipment', alt: '坐姿推胸机型号确认与器械资料' },
    { file: 'teaching', alt: '器械教学视频与添加训练入口' },
  ],
  'gym-training': [
    { file: 'training', alt: '训练计划与逐组完成记录' },
    { file: 'progress', alt: '按日期回看身体指标与变化趋势' },
  ],
  'gym-diet': [{ file: 'meal-preview', alt }],
  'gym-panda-design': [{ file: 'panda-design', alt }],
  'gym-panda-rest': [{ file: 'panda-rest', alt }],
  'gym-comparison': [
    { file: 'before', alt: '调整前的训练首页' },
    { file: 'home', alt: '调整后的训练首页：突出今日训练与熊猫陪伴' },
  ],
};
const images = await Promise.all(groups[name].map(async image => ({
  ...image,
  src: `/images/gym/${image.file}.png`,
  dimensions: await sharp(resolve('public/images/gym', `${image.file}.png`)).metadata(),
})));
---
<div class:list={['gc-image-set', { 'gc-image-set-multiple': images.length > 1, 'gc-image-set-single-phone': images.length === 1 && name !== 'gym-panda-design' }]} style={`--image-columns:${images.length}`}>
  {images.map(image => <figure class="gc-image">
    <img src={image.src} alt={image.alt} width={image.dimensions.width} height={image.dimensions.height} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" data-gallery="gym" />
  </figure>)}
</div>
