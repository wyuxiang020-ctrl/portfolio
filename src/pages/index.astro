---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import { profile } from '../data/profile';
const [masters, bachelors] = profile.education;
const internship = profile.experience[0];
const taglineLines = profile.tagline.replace(' AI ', '\nAI ').split('\n');
const educationYears = (date: string) => date.split(' — ').map(part => part.slice(0, 4)).join(' — ');
const timeline = [
  { date: educationYears(masters.date), title: masters.institution, detail: `${masters.degree.split(' · ')[0]} · ${profile.graduation}` },
  { date: internship.date.replace(/(\d{4}\.\d{2}) — \d{4}\.(\d{2})/, '$1 — $2'), title: internship.institution, detail: internship.role },
  { date: educationYears(bachelors.date), title: bachelors.institution, detail: `${bachelors.degree} · ${bachelors.result.replaceAll(' / ', '/')}` },
];
const projects = [
  { id:'knowledge-copilot', label:'01 / KNOWLEDGE & TRUST', title:'建筑项目知识助手', subtitle:'让每个判断，有据可查。', description:'从历史项目资料中寻找答案，把检索、引用和原文核验连成一条完整路径。', image:'/media/knowledge-answer.png', note:'产品定义 · RAG · 分层评估', stage:'本地 MVP / 合成 Demo 界面' },
  { id:'gym', label:'02 / MULTIMODAL & CONTROL', title:'AI 健身与饮食记录', subtitle:'从自由输入，到确认后的记录。', description:'让文字和照片先成为可编辑草稿，把模型的不确定性留在用户可控制的步骤里。', image:'/media/gym-plan-thumb.webp', note:'多模态交互 · 异常流程 · 评测', stage:'受保护预览 / 实际产品界面' },
  { id:'spatial-portfolio', label:'03 / INFORMATION & INTERACTION', title:'交互式建筑作品集', subtitle:'让复杂的空间，变得容易阅读。', description:'以图纸阅读和按需 3D 探索为线索，设计信息层级、加载反馈与失败恢复。', image:'/media/spatial-home-thumb.webp', note:'信息架构 · 性能取舍 · AI 辅助开发', stage:'已发布项目 / 本地合并迭代' }
];
const architecture = (await getCollection('architecture')).filter(p=>['symsensory','iterative-learning','grandmothers-hearth'].includes(p.id));
---
<BaseLayout home>
  <div class="home-layout">
    <aside class="identity">
      <div><p class="eyebrow">AI PRODUCT · SPATIAL THINKING</p><h1>{profile.name}<span lang="en">{profile.enName}</span></h1><p class="identity-role">{taglineLines.map((line, index) => <>{index > 0 && <br/>}{line}</>)}</p><p class="identity-note">关注真实任务中的信息、判断与信任。<br/>把复杂问题，拆成可体验、可验证的产品。</p><div class="availability" title={profile.availability}><span></span> {profile.direction}方向 · {profile.availability.split('，')[0]}</div></div>
      <nav class="section-nav" aria-label="首页章节"><a href="#projects" class="active"><span></span><small>01</small> AI 与数字产品</a><a href="#architecture"><span></span><small>02</small> 建筑与空间</a><a href="#about"><span></span><small>03</small> 关于与经历</a><a href="#contact"><span></span><small>04</small> 简历与联系</a></nav>
      <div class="identity-links"><a href="/resume/">完整简历 ↗</a><a href={`mailto:${profile.email}`} aria-label="发送邮件">邮件 ↗</a><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a></div>
    </aside>
    <div class="home-content">
      <section class="home-intro"><p>从理解空间中的人，<br/>到设计 AI 与人的协作。</p><div>我的实践从建筑出发，延伸到知识检索、多模态记录与数字体验。这里收录三个产品案例，也保留形成这些判断的建筑实践。</div></section>
      <section id="projects" class="home-section"><div class="section-heading"><h2>精选产品实践</h2><span>SELECTED / 01—03</span></div><div class="product-list">{projects.map(project=><a class="product-row" href={`/projects/${project.id}/`}><div class="product-visual"><img src={project.image} alt={project.title+'项目画面'} width="700" height="440" loading={project.id==='knowledge-copilot'?'eager':'lazy'} decoding="async"/><span>{project.stage}</span></div><div class="product-copy"><p class="eyebrow">{project.label}</p><h3>{project.title}<span aria-hidden="true">↗</span></h3><p class="product-subtitle">{project.subtitle}</p><p>{project.description}</p><small>{project.note}</small></div></a>)}</div><a class="text-link" href="/ai/">浏览 AI 与数字产品 <span>↗</span></a></section>
      <section id="architecture" class="home-section"><div class="section-heading"><h2>建筑与空间选集</h2><span>SPATIAL BACKGROUND</span></div><p class="section-intro">场地、人群、材料与时间。建筑训练让我习惯在约束中理解需求，用图纸与模型表达判断。</p><div class="architecture-selection">{architecture.map((entry,i)=><a class="architecture-item" href={`/architecture/${entry.id}/`}><div class="arch-image"><OptimizedImage gallery={false} src={entry.data.coverImage} alt={entry.data.title.split(' · ')[0]} width="900" height="600" loading="lazy" decoding="async" /></div><div class="architecture-caption"><span class="project-num">0{i+1}</span><div><h3>{entry.data.title.split(' · ')[0]}</h3><p>{entry.data.year} · {entry.data.subtitle}</p></div><span>↗</span></div></a>)}</div><a class="text-link" href="/architecture/">查看全部 7 个建筑项目 <span>↗</span></a></section>
      <section id="about" class="home-section"><div class="section-heading"><h2>关于与经历</h2><span>BACKGROUND</span></div><p class="about-lead">先理解问题，<br/>再选择恰当的技术。</p><p>我在{bachelors.institution}完成{bachelors.degree}阶段学习，目前在{masters.institution}学习 {masters.degree.split(' · ')[0]}。建筑实践让我关注情境、约束和表达；AI 产品实践则让我进一步追问：输出是否可信，流程能否被理解，失败之后如何继续。</p><div class="timeline">{timeline.map(item => <div><span>{item.date}</span><p><strong>{item.title}</strong><small>{item.detail}</small></p></div>)}</div><a class="text-link" href="/about/">更多背景与个人责任 <span>↗</span></a></section>
      <section id="contact" class="home-section home-contact"><p class="eyebrow">LET’S MAKE SOMETHING USEFUL</p><h2>期待参与有真实问题的<br/>AI 产品。</h2><p>{profile.availability}。<br/>欢迎交流产品机会，也欢迎具体的项目反馈。</p><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <span>↗</span></a><div class="actions"><a class="button button-filled" href="/resume/">阅读完整简历 ↗</a><a class="text-link" href={profile.resumePdf}>简历 PDF ↓</a></div></section>
    </div>
  </div>
</BaseLayout>
<style>
  .home-layout{width:min(1212px,calc(100% - 108px));margin:40px auto 0;display:grid;grid-template-columns:370px minmax(0,1fr);gap:110px;align-items:start}.identity{position:sticky;top:70px;min-height:calc(100vh - 170px);max-height:820px;display:flex;flex-direction:column;padding-top:30px}.identity h1{font-size:62px;font-weight:550;letter-spacing:.02em;margin:0 0 30px;line-height:1.3}.identity h1 span{display:block;font-size:17px;letter-spacing:.02em;font-weight:400;color:var(--muted);margin-top:13px}.identity-role{font-size:20px;line-height:1.85;color:var(--text);margin-bottom:21px}.identity-note{font-size:13px;line-height:2;color:var(--quiet)}.availability{display:flex;align-items:center;gap:10px;font-size:10px;color:var(--muted);margin-top:32px;letter-spacing:.03em}.availability>span{height:5px;width:5px;border-radius:100%;background:var(--accent)}.section-nav{display:grid;gap:15px;margin-top:64px}.section-nav a{display:flex;gap:11px;align-items:center;min-height:28px;font-size:11px;color:var(--quiet)}.section-nav a>span{height:1px;width:25px;background:var(--line);transition:width .25s,background .25s}.section-nav a small{font-size:9px;font-family:monospace}.section-nav a.active,.section-nav a:hover{color:var(--text)}.section-nav a.active>span,.section-nav a:hover>span{width:52px;background:var(--accent)}.identity-links{display:flex;gap:22px;font-size:11px;margin-top:auto;padding-top:56px;color:var(--muted)}.home-content{padding-top:28px}.home-intro{padding-bottom:50px;border-bottom:1px solid var(--line)}.home-intro>p{font-size:27px;line-height:1.8;color:var(--text);margin-bottom:24px;letter-spacing:.015em}.home-intro>div{font-size:14px;color:var(--muted);line-height:2}.home-section{padding-top:48px;scroll-margin-top:40px}.section-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:30px}.section-heading h2{font-size:16px;letter-spacing:.03em;margin:0}.section-heading>span{font-size:8px;color:var(--quiet);letter-spacing:.12em}.product-row{display:block;padding-bottom:35px;margin-bottom:35px;border-bottom:1px solid var(--line)}.product-visual{overflow:hidden;background:#dde2de;position:relative;aspect-ratio:1.7}.product-visual img{width:100%;height:100%;object-fit:cover;object-position:top;display:block;transition:transform .5s,opacity .5s}.product-visual>span{position:absolute;bottom:12px;left:12px;font-size:9px;background:#10191dde;padding:4px 8px;color:#d9e6dc;letter-spacing:.02em}.product-row:hover .product-visual img{transform:scale(1.025);opacity:.94}.product-copy{padding-top:23px}.product-copy .eyebrow{font-size:8px;margin-bottom:12px;color:var(--quiet)}.product-copy h3{display:flex;align-items:center;justify-content:space-between;font-size:23px;margin-bottom:9px}.product-copy h3>span{font-size:18px;transition:transform .2s}.product-row:hover h3>span{transform:translate(3px,-3px)}.product-subtitle{color:var(--text);font-size:13px;margin-bottom:10px}.product-copy>p:not(.eyebrow):not(.product-subtitle){font-size:13px;line-height:1.9;margin-bottom:14px}.product-copy small{color:var(--accent);font-size:10px;letter-spacing:.03em}.home-section>.text-link{margin-top:0}.section-intro{font-size:13px;margin-bottom:30px}.architecture-selection{display:grid;gap:28px;margin-bottom:25px}.arch-image{aspect-ratio:1.8;overflow:hidden;background:var(--surface)}.arch-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}.architecture-item:hover img{transform:scale(1.025)}.architecture-caption{display:flex;align-items:baseline;gap:15px;margin-top:14px}.architecture-caption h3{font-size:17px;margin-bottom:5px}.architecture-caption p{font-size:10px;margin:0;color:var(--quiet)}.architecture-caption>span:last-child{margin-left:auto}.project-num{color:var(--quiet);font-size:10px;font-family:monospace}.home-section+.home-section{margin-top:38px}.about-lead{color:var(--text);font-size:27px;margin-bottom:25px;line-height:1.7}#about>p:not(.about-lead){font-size:13px;line-height:2}.timeline{margin:35px 0}.timeline>div{display:grid;grid-template-columns:115px 1fr;gap:20px;padding:21px 0;border-top:1px solid var(--line)}.timeline>div>span{font-size:10px;color:var(--quiet);padding-top:3px}.timeline p{font-size:12px;margin:0}.timeline small{display:block;margin-top:6px;font-size:10px;color:var(--quiet)}.home-contact{padding:45px 0 20px;border-top:1px solid var(--line)}.home-contact h2{font-size:32px;line-height:1.7;margin-bottom:20px}.home-contact>p:not(.eyebrow){font-size:12px}.email-link{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding:14px 0;font-size:18px;margin:28px 0}.home-contact .actions{margin-top:30px}
  @media(min-width:1500px){.home-layout{max-width:1292px;grid-template-columns:400px minmax(0,1fr);gap:130px}.identity h1{font-size:68px}}
  @media(max-width:1100px){.home-layout{width:calc(100% - 64px);grid-template-columns:310px minmax(0,1fr);gap:55px}.identity h1{font-size:52px}.identity-role{font-size:18px}.home-intro>p{font-size:24px}}
  @media(max-width:850px){.home-layout{grid-template-columns:270px minmax(0,1fr);gap:35px}.identity-role{font-size:17px}.identity-note{font-size:11px}.identity h1{font-size:48px}.section-nav{margin-top:45px}}
  @media(max-width:760px){.home-layout{width:calc(100% - 46px);display:block;margin-top:22px}.identity{position:static;min-height:0;max-height:none;padding-top:10px}.identity h1{font-size:51px;margin-bottom:26px}.identity h1 span{font-size:14px;margin-top:8px}.identity-role{font-size:20px}.identity-note{font-size:13px}.availability{margin-top:24px}.section-nav{display:none}.identity-links{padding-top:27px;margin-top:0;font-size:11px}.home-content{padding-top:56px}.home-intro{padding-bottom:34px}.home-intro>p{font-size:24px}.home-intro>div{font-size:13px}.home-section{padding-top:36px}.section-heading{margin-bottom:24px}.section-heading>span{font-size:7px}.product-copy h3{font-size:21px}.product-copy>p:not(.eyebrow):not(.product-subtitle){font-size:13px}.product-copy{padding-top:20px}.product-row{padding-bottom:28px;margin-bottom:28px}.home-section+.home-section{margin-top:22px}.home-contact h2{font-size:28px}.timeline>div{grid-template-columns:95px 1fr;gap:13px}.email-link{font-size:16px}}
</style>
<script>
  const links=[...document.querySelectorAll<HTMLAnchorElement>('.section-nav a')];
  const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){for(const link of links)link.classList.toggle('active',link.hash==='#'+entry.target.id);}}},{rootMargin:'-15% 0px -55% 0px'});
  document.querySelectorAll('.home-section[id]').forEach(section=>observer.observe(section));
</script>


