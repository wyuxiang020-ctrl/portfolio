---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import { projects } from '../data/ai-projects';
import { getCollection } from 'astro:content';
const architecture = await getCollection('architecture');
const hearth = architecture.find(project => project.id === 'grandmothers-hearth')!;
const knowledge = projects[0];
const total = 2 + architecture.length;
const featured = [
  { title: knowledge.title, href: knowledge.href, image: knowledge.image, category: 'product', label: 'AI 产品 / RAG · 知识检索', description: '用自然语言查找建筑资料，从回答中的引用回到原文。让每个判断，有据可查。', date: '2026.05 — 08 · 持续迭代', note: '本人主导 · 本地 MVP · 封面为合成演示界面' },
  { title: '祖母的火塘', href: '/architecture/grandmothers-hearth/', image: hearth.data.coverImage, category: 'architecture', label: '建筑 / 适应性再利用', description: '从泸沽湖的真实走访出发，以火塘与院落为线索，探索家庭生活与访客体验的柔性平衡。', date: hearth.data.year + ' · 设计项目', note: '合作设计 / 王誉翔 × 刘涵' },
];
---
<PortfolioLayout home>
  <div class="hero-band"><section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-identity">
      <p class="hero-role"><span></span> AI 产品经理 / 产品策划</p>
      <h1 id="hero-title">王誉翔<span>Yuxiang Wang</span></h1>
      <p class="hero-statement">理解真实需求，<br/>让 AI 成为可用的产品。</p>
      <div class="hero-education">
        <p>曼彻斯特大学 / 曼彻斯特建筑学院<small>建筑与适应性再利用 · 硕士在读 · 预计 2026.10 毕业</small></p>
        <p>四川美术学院<small>建筑学学士 · 专业排名 1 / 50</small></p>
      </div>
      <a class="hero-work-link" href="/work/">查看作品 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="portrait-space"><img class="hero-portrait" src="/images/yuxiang-portrait-selected-v3.jpg" alt="王誉翔的半身人像" width="1021" height="1540" loading="eager" fetchpriority="high" decoding="async" /></div>
    <div class="hero-bottom"><span>产品定义 / 用户流程 / AI 交互 / 评测迭代</span><span>PORTFOLIO / 2026</span></div>
  </section></div>
  <section class="introduction content-shell" aria-label="关于入口">
    <p>理解人的需求，<br/>也关心想法如何落地。<br/>在产品与建筑中，寻找具体的答案。</p>
    <div class="intro-aside"><p>建筑训练让我习惯观察人与环境的关系；现在，我把这种思考带入 AI 产品，用清晰的流程与可验证的反馈，把复杂问题变成可用的体验。</p><a class="fill-button circle" href="/about/" data-magnetic><span>关于我 ↗</span></a></div>
  </section>
  <section class="home-products content-shell" aria-labelledby="products-title">
    <h2 id="products-title" class="section-kicker">项目实践 <span>PRODUCT & ARCHITECTURE / 02</span></h2>
    <div class="feature-grid">
      {featured.map(project=><article class:list={['feature-card',project.category]}>
        <a href={project.href} aria-label={'查看'+project.title}>
          <div class="feature-image" data-project-preview><OptimizedImage src={project.image} alt={project.title+'项目展示'} gallery={false} sizes="(max-width:760px) 90vw, 45vw" loading="lazy"/><span class="feature-view" aria-hidden="true">查看</span></div>
          <div class="feature-title"><h3>{project.title}</h3><span aria-hidden="true">↗</span></div>
        </a>
        <p class="feature-description">{project.description}</p>
        <div class="feature-meta"><span>{project.label}</span><span>{project.date}</span></div>
        <p class="card-note">{project.note}</p>
      </article>)}
    </div>
    <div class="more-work"><a class="fill-button pill" href="/work/" data-magnetic><span>全部作品<sup>{total}</sup></span></a></div>
  </section>
</PortfolioLayout>
