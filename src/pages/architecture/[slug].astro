---
import { getCollection, render } from 'astro:content';
import ArchitectureLayout from '../../layouts/ArchitectureLayout.astro';
import { architectureOrder } from '../../data/architecture-projects';
export async function getStaticPaths() {
  const projects = await getCollection('architecture');
  const sorted = projects.sort((a,b) => architectureOrder.indexOf(a.id) - architectureOrder.indexOf(b.id));
  return sorted.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---
<ArchitectureLayout entry={entry} prev={prev} next={next}><Content /></ArchitectureLayout>
