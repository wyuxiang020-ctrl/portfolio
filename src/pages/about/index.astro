---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import OptimizedImage from '../../components/ui/OptimizedImage.astro';
import { profile } from '../../data/profile';
const exhibitionImages = ['/images/projects/half-diary/cover.png', '/images/projects/continuation/cover.jpg'];
---
<PortfolioLayout title="关于 — 王誉翔" description="五年美院学习，从重庆到曼城。认识作品背后的王誉翔，以及他的设计、产品实践和生活。">
  <article class="story-page content-shell">
    <header class="story-heading"><p class="section-kicker">关于我 / A LITTLE ABOUT ME</p><h1><span data-line-reveal>你好，我是誉翔。</span><span data-line-reveal>这里是作品之外的我。</span></h1></header>
    <div class="story-divider"><span>CHONGQING → MANCHESTER</span><div class="color-control"><button class="color-orb" type="button" data-color-button aria-label="切换页面点缀颜色"><svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="23"/><ellipse cx="32" cy="32" rx="11" ry="23"/><path d="M9 32h46M13 19c12 6 26 6 38 0M13 45c12-6 26-6 38 0"/></svg></button><span data-color-status class="sr-only" role="status">点击切换颜色</span></div></div>
    <section class="story-opening" aria-label="认识王誉翔">
      <div class="story-text"><p class="story-index">01 / 从重庆出发</p><h2 data-line-reveal>在重庆读书的五年</h2><p>我的本科在四川美术学院。五年里，画图、做模型、布展是学习的一部分，和同学一起评图、改方案也是。比起只看最终的作品，我也喜欢讨论它为什么会是现在的样子。</p><p>美院的训练让我对画面、色彩和排版比较熟悉。现在做产品，我也会自己画界面、搭原型，看看文字是不是好读，操作是不是顺手。</p><p class="story-footnote">四川美术学院 · 建筑学学士<br/>现在在曼彻斯特建筑学院继续学习</p></div>
      <figure class="story-portrait"><OptimizedImage src="/images/about-tree-walk.jpg" alt="王誉翔站在阳光照进的林荫道上" gallery={false} sizes="(max-width:760px) 90vw, 48vw" loading="eager"/><figcaption>日常相册 / 树影和阳光</figcaption></figure>
    </section>
    <section class="story-chapter" aria-labelledby="manchester-story">
      <figure class="story-team"><OptimizedImage src="/images/projects/hard-hat-cafe/gallery-21.png" alt="Hard Hat Café 项目小组围坐在电脑前讨论" gallery={false} sizes="(max-width:760px) 90vw, 46vw"/><figcaption>MSA Live · Hard Hat Café / 小组讨论现场</figcaption></figure>
      <div class="story-text"><p class="story-index">02 / 在曼城，和不同的人一起做事</p><h2 id="manchester-story" data-line-reveal>到了曼彻斯特</h2><p>来曼彻斯特读研之后，小组里多了不同背景的同学。同一个问题，大家关注的地方常常不一样。在 Hard Hat Café 项目中，我们和本地艺术组织合作，到 Nelson 走访，再一起整理成设计方案。</p><p>我喜欢拿着图和大家讨论：哪里没说清楚，哪里还可以试试。比起急着选一个答案，我更愿意先把不同的方案摆在一起看。</p><a class="text-link" href="/architecture/hard-hat-cafe/">看看这次合作 ↗</a></div>
    </section>
    <section class="story-notes" aria-label="我的日常与产品实践"><div><p class="story-index">03 / 现在的兴趣</p><h2 data-line-reveal>项目之外</h2></div><div class="story-text"><p>我喜欢旅行，也热爱打羽毛球。旅行时拍下的照片，和完成的项目一样，都是我想在这里留下的记录。</p><p>最近的另一个兴趣是做自己的产品：查资料太分散，就试着做知识助手；规划旅行要反复切换信息，就做了旅行原型。先选一件小事做完整，再请朋友试试，是我目前喜欢的做法。</p><a class="text-link" href="/work/">我的产品与设计 ↗</a></div><figure class="story-travel"><OptimizedImage src="/images/about-travel.jpg" alt="王誉翔戴着草帽，在彩色建筑前旅行留影" gallery={false} width="942" height="1368"/><figcaption>旅行相册 / 换个地方走走</figcaption></figure></section>
    <section class="story-internship"><p class="section-kicker">实践 / EXPERIENCE</p><h2 data-line-reveal>在真实项目里积累经验。</h2>{profile.experience.map(item => <article class="internship-entry"><header><p>{item.date}</p><h3>{item.institution}</h3><span>{item.role}</span></header><div>{item.projects.map((project,index) => <section class="internship-project"><span>0{index + 1}</span><div><h4>{project.name}</h4><p>{project.description}</p></div></section>)}</div></article>)}</section>
    <section class="story-exhibitions"><div class="story-section-heading"><div><p class="section-kicker">获奖作品 / RECOGNITION</p><h2 data-line-reveal>获奖作品</h2></div><a class="text-link" href="/resume/#skills">完整荣誉 ↗</a></div><div class="work-grid">{profile.exhibitions.map((item,index) => <article class="work-card architecture"><a href={item.href}><div class="work-image" data-project-preview><OptimizedImage src={exhibitionImages[index]} alt={item.project} gallery={false} sizes="(max-width:760px) 90vw, 44vw"/><span class="work-open" aria-hidden="true">查看</span></div><div class="card-title"><h3>{item.project}</h3><span aria-hidden="true">↗</span></div></a><p class="exhibition-caption">{index === 0 ? '优秀毕业设计' : item.name + ' · 入选作品'}</p></article>)}</div></section>
  </article>
  <div class="footer-curve" aria-hidden="true"><svg viewBox="0 0 1000 100" preserveAspectRatio="none"><path d="M0 0 H1000 V0 Q500 140 0 0 Z"/></svg></div>
  <script src="../../scripts/about-interactions.ts"></script>
</PortfolioLayout>
