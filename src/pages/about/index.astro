---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import OptimizedImage from '../../components/ui/OptimizedImage.astro';
import { profile } from '../../data/profile';
const exhibitionImages = ['/images/projects/half-diary/cover.png', '/images/projects/continuation/cover.jpg'];
---
<PortfolioLayout title="关于 — 王誉翔" description="五年美院学习，从重庆到曼城。认识作品背后的王誉翔，以及他的设计、产品实践和生活。">
  <article class="story-page content-shell">
    <header class="story-heading"><p class="section-kicker">关于我 / A LITTLE ABOUT ME</p><h1><span data-line-reveal>在美院学设计，</span><span data-line-reveal>也喜欢把想法做出来。</span></h1></header>
    <div class="story-divider"><span>CHONGQING → MANCHESTER</span><div class="color-control"><button class="color-orb" type="button" data-color-button aria-label="切换页面点缀颜色"><svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="23"/><ellipse cx="32" cy="32" rx="11" ry="23"/><path d="M9 32h46M13 19c12 6 26 6 38 0M13 45c12-6 26-6 38 0"/></svg></button><span data-color-status class="sr-only" role="status">点击切换颜色</span><button type="button" class="color-auto" data-color-auto aria-pressed="false">暂停变色</button></div></div>
    <section class="story-opening" aria-label="认识王誉翔">
      <div class="story-text"><p class="story-index">01 / 从重庆出发</p><h2 data-line-reveal>五年美院，留下了一双挑剔的眼睛。</h2><p>我是王誉翔。在重庆的四川美术学院读了五年建筑。画图、做模型、排版和一次次评图，帮我打下了美术与设计的基础，也让我对比例、色彩和细节有自己的判断。</p><p>我喜欢把事情画出来、摆出来再讨论。一张草图或一个可以点击的原型，往往比解释很久更有用。这也是我做产品时一直保留的习惯。</p><p class="story-footnote">四川美术学院 · 建筑学学士<br/>现在在曼彻斯特建筑学院继续学习</p></div>
      <figure class="story-portrait"><OptimizedImage src="/images/yuxiang-portrait.jpg" alt="王誉翔在旅行途中，倚着栏杆微笑" gallery={false} sizes="(max-width:760px) 90vw, 48vw" loading="eager"/><figcaption>不在电脑前的时候 / 旅行里的一个瞬间</figcaption></figure>
    </section>
    <section class="story-chapter" aria-labelledby="manchester-story">
      <figure class="story-team"><OptimizedImage src="/images/projects/hard-hat-cafe/gallery-21.png" alt="Hard Hat Café 项目小组围坐在电脑前讨论" gallery={false} sizes="(max-width:760px) 90vw, 46vw"/><figcaption>MSA Live · Hard Hat Café / 小组讨论现场</figcaption></figure>
      <div class="story-text"><p class="story-index">02 / 在曼城，和不同的人一起做事</p><h2 id="manchester-story" data-line-reveal>有自己的判断，也听得进不同的意见。</h2><p>从重庆来到曼城，除了换一个地方学习，也多了和不同背景的人合作的机会。在 Hard Hat Café 项目里，我们与跨年级同学、本地艺术组织一起，从 Nelson 的实地走访做到方案汇报。</p><p>我很喜欢这种一起推进事情的过程：把各自的想法拿出来，比较、调整，再分工完成。好的表达不只是讲清楚自己的方案，也要让讨论能继续下去。</p><a class="text-link" href="/architecture/hard-hat-cafe/">看看这次合作 ↗</a></div>
    </section>
    <section class="story-notes" aria-label="我的日常与产品实践"><div><p class="story-index">03 / 现在的兴趣</p><h2 data-line-reveal>做产品，也记得去打球。</h2></div><div class="story-text"><p>最近，我把不少时间花在 AI 产品上。知识助手和健身记录工具都是自己从需求、流程和原型开始，一步步做成可以使用的版本。我擅长把零散的需求整理清楚，也愿意反复试用，找出哪里不好用，再接着改。</p><p>工作学习之外，我热爱打羽毛球。离开屏幕、跑动一会儿，是我很喜欢的放松方式。比起一直埋头想，换个节奏再回来，常常更有精神。</p><a class="text-link" href="/work/">我的产品与设计 ↗</a></div></section>
    <section class="story-internship"><p class="section-kicker">实践 / EXPERIENCE</p><h2 data-line-reveal>在真实项目里积累经验。</h2>{profile.experience.map(item => <article class="internship-entry"><header><p>{item.date}</p><h3>{item.institution}</h3><span>{item.role}</span></header><div>{item.projects.map((project,index) => <section class="internship-project"><span>0{index + 1}</span><div><h4>{project.name}</h4><p>{project.description}</p></div></section>)}</div></article>)}</section>
    <section class="story-exhibitions"><div class="story-section-heading"><div><p class="section-kicker">作品与展览 / EXHIBITIONS</p><h2 data-line-reveal>被看见的作品。</h2></div><a class="text-link" href="/resume/#skills">完整荣誉 ↗</a></div><div class="work-grid">{profile.exhibitions.map((item,index) => <article class="work-card architecture"><a href={item.href}><div class="work-image" data-project-preview><OptimizedImage src={exhibitionImages[index]} alt={item.project} gallery={false} sizes="(max-width:760px) 90vw, 44vw"/><span class="work-open" aria-hidden="true">查看</span></div><div class="card-title"><h3>{item.project}</h3><span aria-hidden="true">↗</span></div></a><p class="exhibition-caption">{item.name} · 入选作品</p></article>)}</div></section>
  </article>
  <div class="footer-curve" aria-hidden="true"><svg viewBox="0 0 1000 100" preserveAspectRatio="none"><path d="M0 0 H1000 V0 Q500 140 0 0 Z"/></svg></div>
  <script src="../../scripts/about-interactions.ts"></script>
</PortfolioLayout>
