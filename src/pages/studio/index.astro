---
import { profile } from '../../data/profile';
const rooms = [
  { id:'ai', number:'01', name:'AI 实验馆', en:'IDEAS INTO PRODUCTS', title:'让想法，成为可用的产品。', copy:'知识检索、引用核验、多模态记录。探索 AI 如何参与真实任务中的判断与协作。', image:'/media/knowledge-answer.png', alt:'建筑项目知识助手的回答与引用界面', link:'/ai/', label:'走进 AI 实验馆', projects:[{title:'建筑项目知识助手',detail:'检索 · 回答 · 核验',href:'/projects/knowledge-copilot/'},{title:'AI 健身与饮食记录',detail:'输入 · 草稿 · 确认',href:'/projects/gym/'}]},
  { id:'architecture', number:'02', name:'建筑展馆', en:'SPACE & EXPERIENCE', title:'空间里，始终有人。', copy:'从场地与人群出发，通过图纸、材料和模型，把一个空间想法慢慢变成可以理解的体验。', image:'/optimized/76dd66d6cb70976f-960.webp', alt:'新五感建筑作品的流线形空间', link:'/architecture/', label:'走进建筑展馆', projects:[{title:'建筑与空间作品选集',detail:'七个空间实践',href:'/architecture/'},{title:'交互式建筑作品集',detail:'图纸阅读 · 3D 探索',href:'/projects/spatial-portfolio/'}]},
  { id:'about', number:'03', name:'个人工作室', en:'A LITTLE ABOUT ME', title:'从建筑出发，继续探索。', copy:'我是王誉翔，具有建筑与空间设计背景的 AI 产品实践者。喜欢把复杂的问题，拆成可以体验和验证的步骤。', image:null, alt:'', link:'/about/', label:'认识一下我', projects:[{title:'我的背景与经历',detail:'建筑 × AI 产品',href:'/about/'},{title:'完整简历',detail:'经历 · 实践 · 联系方式',href:'/resume/'}]}
];
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="theme-color" content="#f2efe7"/>
  <meta name="description" content="王誉翔的圆形小小研究所。从一条舒展的丝带，到 AI、建筑与个人工作室。"/>
  <meta name="robots" content="noindex"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <title>弧间 · 王誉翔的小小研究所</title>
</head>
<body>
  <a class="skip" href="#selected-work">直接浏览作品</a>
  <header class="header">
    <a class="brand" href="/studio/" aria-label="王誉翔的小小研究所首页"><span class="brand-icon" aria-hidden="true">y.</span><span>王誉翔<span class="brand-sub">A LITTLE STUDIO</span></span></a>
    <nav aria-label="主导航"><a href="/ai/">AI 作品</a><a href="/architecture/">建筑作品</a><a href="/about/">关于我</a><a class="resume-link" href="/resume/">简历 <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main>
    <section class="world" id="ribbon-studio" aria-label="圆形建筑互动场景" data-status="loading" data-selected="">
      <div class="world-canvas" id="studio-canvas" aria-label="三个由连续曲面墙围合的卡通建筑，可以拖动旋转和点击选择。"></div>
      <div class="world-grain" aria-hidden="true"></div>
      <div class="intro-copy" id="studio-intro">
        <p class="eyebrow"><span></span> 弧间 · 小小研究所</p>
        <h1>让想法，<br/>慢慢<span class="serif">围合。</span></h1>
        <p class="intro-description">一条线，三座小馆。<br/>从建筑空间，到 AI 与人的协作。</p>
        <button type="button" class="primary-action" id="grow-world" disabled><span>正在搭建空间</span><span class="action-circle" aria-hidden="true">↗</span></button>
        <a class="skip-world" href="#selected-work">直接看看作品 <span aria-hidden="true">↓</span></a>
      </div>
      <div class="world-hint" aria-hidden="true"><span class="tiny-orbit">✳</span><span>一个可以靠近、打开<br/>和慢慢探索的小世界</span></div>
      <div class="room-labels" id="room-labels" hidden>{rooms.map(room=><button type="button" class="room-label" data-room={room.id} aria-label={`探索${room.name}`} aria-pressed="false"><span>{room.number}</span>{room.name}<span class="label-arrow" aria-hidden="true">↗</span></button>)}</div>
      <aside class="room-panel" id="room-panel" aria-label="选中空间的作品" hidden>
        <button type="button" class="back-overview" id="back-overview"><span aria-hidden="true">←</span> 回到小世界</button>
        {rooms.map(room=><div class="room-content" data-content={room.id} hidden>
          <p class="eyebrow">{room.number} / {room.en}</p><h2>{room.name}</h2><p class="room-tagline">{room.title}</p>
          {room.image ? <div class="room-preview"><img src={room.image} alt={room.alt} loading="lazy" width="600" height="360"/></div> : <div class="personal-note"><span>你好，我是誉翔。</span><p>用空间理解人，<br/>用产品连接想法。</p><small>ARCHITECTURE → AI PRODUCT</small></div>}
          <p class="room-description">{room.copy}</p>
          <div class="room-projects">{room.projects.map(project=><a href={project.href}><span>{project.title}<small>{project.detail}</small></span><span aria-hidden="true">↗</span></a>)}</div>
          <a class="room-enter" href={room.link}>{room.label}<span aria-hidden="true">↗</span></a>
        </div>)}
      </aside>
      <div class="scene-bottom">
        <div class="scene-instruction"><span class="mouse-symbol" aria-hidden="true"></span><span id="scene-instruction">拖动旋转 · 点击圆馆</span></div>
        <div class="form-control"><div class="form-label"><label for="ribbon-form">一条丝带的变化</label><output for="ribbon-form" id="form-value">舒展</output></div><div class="form-track"><span aria-hidden="true">〰</span><input id="ribbon-form" type="range" min="0" max="100" step="1" value="0" aria-label="墙体围合程度" disabled/><span aria-hidden="true">◯</span></div></div>
        <div class="scene-actions"><button type="button" id="replay-world" disabled aria-label="重新播放墙体围合">↻<span>重播</span></button><button type="button" id="open-roofs" disabled aria-pressed="false"><span aria-hidden="true">⌁</span><span>打开屋顶</span></button><button type="button" id="night-world" disabled aria-pressed="false"><span aria-hidden="true">☾</span><span>夜晚</span></button></div>
      </div>
      <div class="scene-loading" id="scene-loading" role="status"><span></span> 正在搭建小世界…</div>
      <div class="scene-fallback" id="scene-fallback" hidden><p>这个小世界暂时没能展开。</p><button type="button" id="retry-world">再试一次 ↻</button><a href="#selected-work">先浏览作品 ↓</a></div>
      <div class="visually-hidden" id="scene-status" role="status" aria-live="polite"></div>
    </section>
    <section class="selected-work" id="selected-work">
      <div class="section-intro"><div><p class="eyebrow">CURIOUS ABOUT WHAT’S INSIDE?</p><h2>走近一些，<br/>看看想法如何落地。</h2></div><p>我的实践从建筑出发，<br/>延伸到知识检索、数字产品与空间体验。</p></div>
      <div class="work-grid">
        <a class="work-card" href="/projects/knowledge-copilot/"><div class="work-image"><img src="/media/knowledge-answer.png" alt="知识助手回答与引用界面" loading="lazy" width="700" height="440"/></div><div class="work-heading"><h3>建筑项目知识助手</h3><span>↗</span></div><p>01 / AI PRODUCT · 检索、引用与信任</p></a>
        <a class="work-card" href="/projects/gym/"><div class="work-image"><img src="/media/gym-plan-thumb.webp" alt="AI 健身与饮食记录界面" loading="lazy" width="700" height="440"/></div><div class="work-heading"><h3>AI 健身与饮食记录</h3><span>↗</span></div><p>02 / AI PRODUCT · 多模态与用户控制</p></a>
        <a class="work-card" href="/architecture/"><div class="work-image"><img src="/optimized/76dd66d6cb70976f-960.webp" alt="新五感建筑作品的流线形空间" loading="lazy" width="700" height="440"/></div><div class="work-heading"><h3>建筑与空间选集</h3><span>↗</span></div><p>03 / ARCHITECTURE · 场地、材料与时间</p></a>
      </div>
    </section>
  </main>
  <footer><a href="/about/">从建筑出发，继续探索。 <span>↗</span></a><a href={`mailto:${profile.email}`}>{profile.email}</a><span>© 2026 {profile.enName}</span></footer>
  <script>import '../../scripts/ribbon-studio';</script>
</body>
</html>
<style is:global>
  :root{color-scheme:light;--paper:#f2efe7;--ink:#38493f;--soft:#626e63;--line:#d4d8cc;--green:#485f4b;--night:0}
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:30px}body{margin:0;background:var(--paper);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;-webkit-font-smoothing:antialiased;transition:background 1.1s,color 1.1s}body.is-night{--paper:#253539;--ink:#e8e6d4;--soft:#b4b9a9;--line:#526362;--green:#c0cba6}a{color:inherit;text-decoration:none}button,input{font:inherit}button{cursor:pointer;color:inherit}button:disabled{cursor:wait}button,a,input{-webkit-tap-highlight-color:transparent}button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--green);outline-offset:6px}::selection{background:#bfd1b3;color:#344b3e}button{background:none}h1,h2,h3,p{margin:0}button[hidden],[hidden]{display:none!important}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip{position:fixed;left:24px;top:-70px;background:var(--ink);color:var(--paper);z-index:50;padding:12px}.skip:focus{top:12px}
  .header{position:absolute;top:0;left:0;right:0;height:98px;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:0 5.5%;pointer-events:none}.header a,.header nav{pointer-events:auto}.brand{display:flex;align-items:center;gap:14px;font-size:13px;font-weight:500;letter-spacing:.08em}.brand-icon{font:italic 39px/1 Georgia,serif;letter-spacing:-5px;background:var(--ink);color:var(--paper);width:48px;height:48px;border-radius:50%;display:flex;justify-content:center;padding:0 5px 0 0;align-items:center}.brand-sub{display:block;font-size:8px;letter-spacing:.12em;margin-top:7px;font-weight:400;color:var(--soft)}.header nav{display:flex;align-items:center;gap:32px;font-size:12px}.header nav>a{position:relative;padding:10px 0}.header nav>a:after{content:'';position:absolute;left:0;right:100%;bottom:4px;height:1px;background:currentColor;transition:right .3s}.header nav>a:hover:after{right:0}.header nav .resume-link{margin-left:12px;display:flex;gap:18px;border:1px solid var(--line);padding:10px 17px;border-radius:30px}
  .world{position:relative;height:min(940px,100svh);min-height:690px;overflow:hidden;border-bottom:1px solid var(--line)}.world-canvas{position:absolute;inset:75px 0 80px;touch-action:pan-y;outline:0}.world-canvas canvas{display:block;width:100%;height:100%;touch-action:pan-y;cursor:grab}.world-canvas canvas:active{cursor:grabbing}.world-canvas.is-hovering canvas{cursor:pointer}.world-grain{position:absolute;inset:0;pointer-events:none;opacity:.1;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' opacity='.17' d='M0 0h180v180H0z'/%3E%3C/svg%3E")}
  .intro-copy{position:absolute;left:5.5%;top:25%;width:300px;z-index:3;transition:opacity .35s,transform .6s}.eyebrow{font-size:10px;line-height:1.6;letter-spacing:.12em;font-weight:500;display:flex;align-items:center;gap:10px}.eyebrow>span{display:inline-block;width:5px;height:5px;border-radius:50%;background:#8c9c6a}.intro-copy h1{font-size:clamp(40px,4.2vw,68px);line-height:1.28;letter-spacing:-.03em;font-weight:450;margin:28px 0 23px}.serif{font-family:"Songti SC","SimSun",serif;font-weight:400}.intro-description{font-size:13px;line-height:2.1;color:var(--soft)}.primary-action{display:flex;align-items:center;gap:24px;padding:0;border:0;font-size:13px;margin:35px 0 19px;min-height:48px}.action-circle{display:grid;place-items:center;background:var(--ink);color:var(--paper);width:43px;height:43px;border-radius:50%;font-size:20px;transition:transform .35s}.primary-action:hover .action-circle{transform:rotate(45deg)}.skip-world{font-size:11px;color:var(--soft);display:inline-flex;gap:17px;align-items:center;padding:6px 0}.world-hint{position:absolute;top:139px;right:5.5%;display:flex;align-items:center;gap:13px;font-size:10px;line-height:1.8;color:var(--soft);pointer-events:none}.tiny-orbit{font-size:27px;line-height:1;color:#829473}
  .room-labels{position:absolute;inset:75px 0 80px;pointer-events:none;z-index:5}.room-label{position:absolute;left:0;top:0;display:flex;align-items:center;gap:9px;background:#f8f5ebeb;border:1px solid #faf9f2;box-shadow:0 4px 15px #3447300b;backdrop-filter:blur(8px);color:#495544;border-radius:30px;padding:8px 13px 8px 8px;font-size:11px;white-space:nowrap;pointer-events:auto;transition:opacity .35s,background .25s,box-shadow .25s;will-change:transform;min-height:38px}.room-label>span:first-child{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#e3e8d7;color:#637258;font-size:9px}.room-label:hover,.room-label[aria-pressed=true]{background:#fffef7;box-shadow:0 6px 22px #34473020}.label-arrow{font-size:14px;margin-left:3px}.room-label[aria-pressed=true]>span:first-child{background:#52634b;color:#fff}.world[data-selected]:not([data-selected=""]) .intro-copy{opacity:0;pointer-events:none;transform:translateX(-15px)}
  .room-panel{position:absolute;left:5.5%;top:122px;max-height:calc(100% - 215px);overflow-y:auto;scrollbar-width:thin;width:min(318px,27%);z-index:8;background:color-mix(in srgb,var(--paper) 85%,transparent);backdrop-filter:blur(14px);padding:0 20px 18px 0;border-radius:0 0 18px 0;animation:panel-in .5s ease both}.back-overview{display:flex;gap:12px;align-items:center;border:0;padding:8px 0;font-size:11px;margin-bottom:26px;color:var(--soft);min-height:38px}.room-content .eyebrow{font-size:8px;letter-spacing:.1em;color:var(--soft)}.room-content h2{font-size:32px;font-weight:450;letter-spacing:-.03em;margin:12px 0 8px}.room-tagline{font-size:12px;color:var(--soft);line-height:1.8}.room-preview{aspect-ratio:1.7;overflow:hidden;border-radius:4px;margin:23px 0 17px;background:#e6e6db;border:5px solid #fcfaf1}.room-preview img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}.room-description{font-size:11px;line-height:1.95;color:var(--soft)}.room-projects{margin-top:18px}.room-projects>a{border-top:1px solid var(--line);padding:12px 0;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12px}.room-projects>a:hover>span:last-child{transform:translate(2px,-2px)}.room-projects small{display:block;font-size:9px;color:var(--soft);margin-top:5px}.room-enter{margin-top:15px;display:flex;align-items:center;justify-content:space-between;background:var(--ink);color:var(--paper);padding:13px 17px;border-radius:3px;font-size:12px}.personal-note{padding:23px 19px;background:#dce3cf;color:#46583e;border-radius:2px 19px 2px 2px;margin:22px 0 17px;transform:rotate(-2deg)}.personal-note>span{font-size:10px}.personal-note p{font-family:"Songti SC","SimSun",serif;font-size:23px;line-height:1.7;margin:14px 0}.personal-note small{font-size:8px;letter-spacing:.11em}
  .scene-bottom{position:absolute;bottom:26px;left:5.5%;right:5.5%;display:flex;align-items:center;justify-content:space-between;gap:30px;z-index:10}.scene-instruction{display:flex;align-items:center;gap:12px;font-size:10px;color:var(--soft);min-width:155px}.mouse-symbol{display:block;width:14px;height:20px;border:1px solid var(--soft);border-radius:8px;position:relative}.mouse-symbol:before{content:'';position:absolute;width:1px;height:5px;top:3px;left:5.5px;background:var(--soft)}.form-control{width:260px;max-width:35%;}.form-label{display:flex;justify-content:space-between;align-items:center;font-size:10px;margin-bottom:7px}.form-label output{color:var(--soft)}.form-track{display:flex;align-items:center;gap:12px;font-size:22px;line-height:1}.form-track>span:last-child{font-size:17px}input[type=range]{appearance:none;width:100%;height:20px;background:transparent;margin:0;cursor:ew-resize}input[type=range]::-webkit-slider-runnable-track{height:3px;border-radius:4px;background:linear-gradient(to right,var(--ink) var(--form-progress,0%),var(--line) var(--form-progress,0%))}input[type=range]::-webkit-slider-thumb{appearance:none;width:14px;height:14px;background:var(--paper);border:3px solid var(--ink);border-radius:50%;margin-top:-5.5px;box-shadow:0 0 0 4px var(--paper)}input[type=range]::-moz-range-track{height:3px;background:var(--line)}input[type=range]::-moz-range-progress{background:var(--ink)}input[type=range]::-moz-range-thumb{width:10px;height:10px;border:3px solid var(--ink);border-radius:50%;background:var(--paper)}.scene-actions{display:flex;align-items:center;gap:9px}.scene-actions button{height:43px;border:1px solid var(--line);background:var(--paper);border-radius:30px;display:flex;gap:8px;align-items:center;justify-content:center;padding:0 14px;font-size:15px;transition:background .2s,transform .2s}.scene-actions button>span:last-child{font-size:10px}.scene-actions button:hover{transform:translateY(-2px)}.scene-actions button[aria-pressed=true]{background:var(--ink);color:var(--paper)}.scene-loading{position:absolute;left:65%;top:55%;transform:translate(-50%,-50%);font-size:11px;color:var(--soft);display:flex;align-items:center;gap:10px;transition:opacity .5s;pointer-events:none}.scene-loading>span{width:14px;height:14px;border:1px solid var(--line);border-top-color:var(--ink);border-radius:50%;animation:spin 1s linear infinite}.world[data-status=ready] .scene-loading{opacity:0}.scene-fallback{position:absolute;left:55%;top:42%;max-width:300px;font-size:15px}.scene-fallback a,.scene-fallback button{display:inline-block;border:0;border-bottom:1px solid var(--line);padding:10px 0;margin:15px 14px 0 0;font-size:12px}.world[data-status=error] .scene-loading{display:none}
  .selected-work{max-width:1440px;margin:auto;padding:104px 5.5% 90px}.section-intro{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:48px;gap:30px}.section-intro .eyebrow{font-size:9px;color:var(--soft);margin-bottom:20px}.section-intro h2{font-size:38px;font-weight:450;line-height:1.5;letter-spacing:-.035em}.section-intro>p{font-size:12px;color:var(--soft);line-height:2.1;margin-bottom:8px}.work-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.work-image{aspect-ratio:1.45;background:#e6e9df;border-radius:4px;overflow:hidden;padding:12px;transition:background .35s}.work-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:top;box-shadow:0 10px 20px #38493f14;transition:transform .6s}.work-card:hover img{transform:scale(1.045)}.work-heading{display:flex;align-items:center;justify-content:space-between;margin:18px 0 9px;gap:10px}.work-heading h3{font-size:16px;font-weight:450}.work-card>p{font-size:9px;color:var(--soft);letter-spacing:.03em}.work-heading>span{transition:transform .3s}.work-card:hover .work-heading>span{transform:translate(3px,-3px)}footer{border-top:1px solid var(--line);margin:0 5.5%;padding:29px 0 34px;display:flex;gap:25px;justify-content:space-between;align-items:center;font-size:11px;color:var(--soft)}footer>a:first-child{font-size:14px;color:var(--ink)}footer>a:first-child>span{margin-left:16px}footer>span{font-size:9px}
  @keyframes spin{to{transform:rotate(360deg)}}@keyframes panel-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  @media(min-width:1600px){.world{min-height:870px}.intro-copy{top:28%}.room-panel{top:190px;width:330px}.world-hint{top:155px}}
