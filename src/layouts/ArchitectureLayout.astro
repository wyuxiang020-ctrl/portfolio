---
import BaseLayout from './BaseLayout.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import { architectureNotes } from '../data/architecture-projects';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'architecture'>; prev?: CollectionEntry<'architecture'> | null; next?: CollectionEntry<'architecture'> | null }
const { entry, prev, next } = Astro.props;
const data = entry.data, notes = architectureNotes[entry.id];
const [titleCN, titleEN] = data.title.split(' · ');
---
<BaseLayout title={`${titleCN} · 王誉翔`} description={data.description} wide>
  <article class="architecture-case" data-gallery-group={entry.id}>
    <header class="architecture-header container">
      <a class="back-link" href="/architecture/">← 建筑与空间</a>
      <p class="eyebrow">ARCHITECTURE / {data.year}</p>
      <h1>{titleCN}</h1>
      <p class="english-title" lang="en">{titleEN}</p>
      <p class="architecture-deck">{data.description}</p>
      <dl class="architecture-meta"><div><dt>地点</dt><dd>{data.location}</dd></div><div><dt>类型</dt><dd>{data.projectType}</dd></div><div><dt>参与角色</dt><dd>{notes.role}</dd></div>{data.area && <div><dt>规模</dt><dd>{data.area}</dd></div>}{data.collaborators && <div><dt>项目合作</dt><dd>{data.collaborators}</dd></div>}</dl>
    </header>
    <figure class="architecture-hero container"><OptimizedImage src={data.bannerImage ?? data.coverImage} alt={`${titleCN} · 项目主视觉`} loading="eager" fetchpriority="high" sizes="(max-width: 760px) calc(100vw - 46px), 1120px" /><figcaption>项目主视觉 · 点击图片查看完整原图</figcaption></figure>
    <div class="architecture-body container">
      <div class="architecture-prose"><slot /></div>
    </div>
    <nav class="architecture-next container" aria-label="更多建筑项目">
      {prev ? <a href={`/architecture/${prev.id}/`}><span>← 上一个项目</span><strong>{architectureNotes[prev.id].title}</strong></a> : <a href="/architecture/"><span>全部建筑作品</span><strong>回到选集 ↗</strong></a>}
      {next ? <a href={`/architecture/${next.id}/`}><span>下一个项目 →</span><strong>{architectureNotes[next.id].title}</strong></a> : <a href="/work/"><span>全部作品</span><strong>返回作品列表 ↗</strong></a>}
    </nav>
  </article>
</BaseLayout>
<style>
  .architecture-header{padding-top:38px;padding-bottom:38px}.back-link{display:inline-flex;font-size:12px;color:var(--muted);padding:8px 0;margin-bottom:38px}.architecture-header .eyebrow{margin-bottom:18px}.architecture-header h1{font-size:clamp(31px,4.2vw,58px);margin:0 0 10px;max-width:960px}.english-title{font-size:14px;letter-spacing:.035em;color:var(--quiet);margin-bottom:28px}.architecture-deck{font-size:15px;line-height:1.9;max-width:760px;margin-bottom:35px}.architecture-meta{display:grid;grid-template-columns:1fr 1fr 1.6fr;gap:24px 40px;border-top:1px solid var(--line);padding-top:25px;margin:0}.architecture-meta dt{font-size:10px;letter-spacing:.12em;color:var(--quiet);margin-bottom:8px}.architecture-meta dd{font-size:12px;line-height:1.8;margin:0;color:var(--muted)}.architecture-hero{margin-block:12px 65px}.architecture-hero :global(img){display:block;width:100%;height:auto;max-height:70vh;object-fit:contain;background:var(--surface)}.architecture-hero figcaption{font-size:10px;color:var(--quiet);text-align:right;padding-top:9px}.architecture-body{display:block;max-width:960px}.architecture-context{position:sticky;top:36px;font-size:11px;line-height:1.9}.architecture-context .eyebrow{font-size:10px;margin-bottom:16px}.architecture-context a{display:block;color:var(--accent);margin-top:25px}.architecture-prose{min-width:0;width:100%;max-width:960px;margin:auto}.architecture-next{display:grid;grid-template-columns:1fr 1fr;gap:30px;border-top:1px solid var(--line);padding-top:32px;margin-top:70px}.architecture-next a:last-child{text-align:right}.architecture-next span{display:block;font-size:11px;color:var(--quiet);margin-bottom:10px}.architecture-next strong{font-size:17px;font-weight:500}
  .architecture-prose :global(p){font-size:13px;line-height:1.95;margin-bottom:1.5em}.architecture-prose :global(h2){font-size:25px;line-height:1.45;margin:60px 0 12px;scroll-margin-top:35px}.architecture-prose :global(h2:first-child){margin-top:0}.architecture-prose :global(h3){font-size:19px;line-height:1.5;margin:35px 0 16px}.architecture-prose :global(.h-sub){display:block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--quiet);margin:-4px 0 26px}.architecture-prose :global(img){display:block;width:100%;height:auto;margin:28px 0;background:#e8e8e2}.architecture-prose :global(.caption){font-size:11px;line-height:1.75;color:var(--quiet);margin:-14px 0 30px}.architecture-prose :global(hr){margin:44px 0;opacity:.55}.architecture-prose :global(blockquote){font-size:13px}.architecture-prose :global(blockquote p){font-size:13px}.architecture-prose :global(ul),.architecture-prose :global(ol){padding-left:22px;color:var(--muted);font-size:13px}.architecture-prose :global(.img-two),.architecture-prose :global(.img-two-crop){display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:25px 0}.architecture-prose :global(.img-three){display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:25px 0}.architecture-prose :global(.img-two img),.architecture-prose :global(.img-three img),.architecture-prose :global(.img-two-crop img){margin:0;align-self:center;object-fit:contain}.architecture-prose :global(details){margin:28px 0;border-left:1px solid var(--line);padding-left:20px}.architecture-prose :global(summary){font-size:12px;color:var(--accent);cursor:pointer;padding:10px 0;min-height:44px}.architecture-prose :global(summary:focus-visible){outline:2px solid var(--accent);outline-offset:5px}.architecture-prose :global(.itb-chapters),.architecture-prose :global(.project-chapters){display:flex;flex-wrap:wrap;gap:4px 20px;font-size:11px;padding:18px 0;margin:25px 0;border-block:1px solid var(--line);color:var(--accent)}.architecture-prose :global(.itb-chapters a),.architecture-prose :global(.project-chapters a){padding:8px 0}.architecture-prose :global(table){display:block;overflow:auto;font-size:12px}.architecture-prose :global(.model-intro p){color:#363b38}.architecture-prose :global(.model-note){color:#363b38}
  @media(max-width:1000px){.architecture-body{grid-template-columns:150px minmax(0,1fr);gap:35px}.architecture-meta{grid-template-columns:1fr 1fr;gap:22px}}
  @media(max-width:760px){.architecture-header{padding-top:12px;padding-bottom:25px}.back-link{margin-bottom:24px}.architecture-deck{font-size:13px;margin-bottom:26px}.english-title{font-size:11px}.architecture-meta{gap:18px 22px}.architecture-meta dd{font-size:11px}.architecture-meta>div:nth-child(3){grid-column:1/-1}.architecture-hero{margin-block:6px 35px}.architecture-hero :global(img){max-height:58vh}.architecture-body{display:block}.architecture-context{position:static;border-left:1px solid var(--line);padding-left:16px;margin-bottom:45px}.architecture-context p{margin-bottom:8px}.architecture-context a{margin-top:12px}.architecture-prose :global(p){font-size:12px;line-height:1.95}.architecture-prose :global(h2){font-size:22px;margin-top:44px}.architecture-prose :global(.h-sub){font-size:9px}.architecture-prose :global(.img-three){grid-template-columns:1fr}.architecture-prose :global(.img-two),.architecture-prose :global(.img-two-crop){gap:8px}.architecture-prose :global(.caption){font-size:10px;line-height:1.7}.architecture-next{gap:22px;margin-top:50px}.architecture-next strong{font-size:14px}}
</style>
